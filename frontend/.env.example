# These names are intentionally specific to this site: the MyDevil account also
# runs other applications with their own environment variables.
PIXEL_NA_WARSTWIE_SITE_URL=https://pixelnawarstwie.pl
# Leave empty only when deliberately serving the bundled local articles.
CMS_URL=
# Server-side secrets. Required for real contact form delivery.
PIXEL_NA_WARSTWIE_RESEND_API_KEY=
PIXEL_NA_WARSTWIE_CONTACT_FROM_EMAIL=Pixel na Warstwie <kontakt@pixelnawarstwie.pl>
PIXEL_NA_WARSTWIE_CONTACT_TO_EMAIL=kontakt@pixelnawarstwie.pl
