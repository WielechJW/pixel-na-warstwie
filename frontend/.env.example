# Public canonical URL; set the same value at build time and runtime.
SITE_URL=https://pixelnawarstwie.pl
# Leave empty only when deliberately serving the bundled local articles.
CMS_URL=
# Server-side secrets. Required for real contact form delivery.
# SMTP takes priority over Resend when configured.
SMTP_HOST=mail70.mydevil.net
SMTP_PORT=465
SMTP_USER=kontakt@pixelnawarstwie.pl
SMTP_PASSWORD=
# Leave SMTP_HOST, SMTP_USER and SMTP_PASSWORD empty to use Resend instead.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=kontakt@pixelnawarstwie.pl
CONTACT_TO_EMAIL=pixelnawarstwie@gmail.com
